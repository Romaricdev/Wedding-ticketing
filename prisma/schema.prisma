// Schéma métier Phase 1 — docs/SPECIFICATION_BASE_DE_DONNEES.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EventRole {
  ADMIN
  CONTROLLER
}

enum GuestStatus {
  ACTIVE
  CANCELLED
  ARCHIVED
}

enum TicketType {
  SINGLE
  COUPLE
}

enum TicketStatus {
  ACTIVE
  USED
  REVOKED
  CANCELLED
}

enum CheckInResult {
  ACCEPTED
  MANUAL_ACCEPTED
  ALREADY_USED
  INVALID
  REVOKED
  CANCELLED
  DENIED
}

enum AuditAction {
  EVENT_UPDATED
  TABLE_CREATED
  TABLE_UPDATED
  TABLE_DELETED
  GUEST_CREATED
  GUEST_UPDATED
  GUEST_CANCELLED
  TICKET_CREATED
  TICKET_REISSUED
  TICKET_REVOKED
  TICKET_CANCELLED
  CONTROLLER_CREATED
  CONTROLLER_DISABLED
  CHECK_IN_ACCEPTED
  CHECK_IN_MANUAL_ACCEPTED
}

model Event {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(160)
  weddingDate DateTime?   @map("wedding_date") @db.Timestamptz(6)
  venueName   String?     @map("venue_name") @db.VarChar(200)
  timezone    String      @default("Africa/Douala") @db.VarChar(64)
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  eventUsers       EventUser[]
  diningTables     DiningTable[]
  guests           Guest[]
  ticketTemplates  TicketTemplate[]
  tickets          Ticket[]
  checkInAttempts  CheckInAttempt[]
  auditLogs        AuditLog[]

  @@index([status], map: "events_status_idx")
  @@map("events")
}

model EventUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  authUserId   String    @map("auth_user_id") @db.Uuid
  displayName  String    @map("display_name") @db.VarChar(120)
  role         EventRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  event               Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdTemplates    TicketTemplate[]   @relation("TemplateCreatedBy")
  checkedInTickets    Ticket[]           @relation("TicketCheckedInBy")
  checkInAttempts     CheckInAttempt[]
  auditLogs           AuditLog[]

  @@unique([eventId, authUserId], map: "event_users_event_id_auth_user_id_key")
  @@index([eventId, role, isActive], map: "event_users_event_id_role_is_active_idx")
  @@map("event_users")
}

model DiningTable {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  label     String   @db.VarChar(80)
  capacity  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  guests  Guest[]
  tickets Ticket[]

  @@unique([eventId, label], map: "dining_tables_event_id_label_key")
  @@unique([eventId, id], map: "dining_tables_event_id_id_key")
  @@index([eventId, label], map: "dining_tables_event_id_label_idx")
  @@map("dining_tables")
}

model Guest {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String      @map("event_id") @db.Uuid
  lastName   String      @map("last_name") @db.VarChar(120)
  firstNames String      @map("first_names") @db.VarChar(160)
  tableId    String?     @map("table_id") @db.Uuid
  status     GuestStatus @default(ACTIVE)
  notes      String?     @db.Text
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  diningTable  DiningTable?  @relation(fields: [eventId, tableId], references: [eventId, id], onDelete: SetNull)
  ticketGuests TicketGuest[]

  @@index([eventId, status, tableId], map: "guests_event_id_status_table_id_idx")
  @@map("guests")
}

model TicketTemplate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  storageBucket    String   @map("storage_bucket") @db.VarChar(80)
  storagePath      String   @map("storage_path") @db.Text
  originalFilename String   @map("original_filename") @db.VarChar(255)
  pageNumber       Int      @default(1) @map("page_number") @db.SmallInt
  qrX              Decimal  @map("qr_x") @db.Decimal(10, 2)
  qrY              Decimal  @map("qr_y") @db.Decimal(10, 2)
  qrSize           Decimal  @map("qr_size") @db.Decimal(10, 2)
  isActive         Boolean  @default(false) @map("is_active")
  createdByUserId  String?  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy EventUser? @relation("TemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tickets   Ticket[]

  @@map("ticket_templates")
}

model Ticket {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId             String       @map("event_id") @db.Uuid
  templateId          String?      @map("template_id") @db.Uuid
  tableId             String       @map("table_id") @db.Uuid
  shortCode           String       @map("short_code") @db.VarChar(16)
  type                TicketType
  status              TicketStatus @default(ACTIVE)
  tokenHash           String       @unique @map("token_hash") @db.Char(64)
  version             Int          @default(1)
  issuedAt            DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  checkedInAt         DateTime?    @map("checked_in_at") @db.Timestamptz(6)
  checkedInByUserId   String?      @map("checked_in_by_user_id") @db.Uuid
  revokedAt           DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedReason       String?      @map("revoked_reason") @db.VarChar(300)
  pdfStorageBucket    String?      @map("pdf_storage_bucket") @db.VarChar(80)
  pdfStoragePath      String?      @map("pdf_storage_path") @db.Text
  pdfGeneratedAt      DateTime?    @map("pdf_generated_at") @db.Timestamptz(6)
  pdfError            String?      @map("pdf_error") @db.VarChar(500)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  template        TicketTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  diningTable     DiningTable        @relation(fields: [eventId, tableId], references: [eventId, id], onDelete: Restrict)
  checkedInBy     EventUser?         @relation("TicketCheckedInBy", fields: [checkedInByUserId], references: [id], onDelete: SetNull)
  ticketGuests    TicketGuest[]
  checkInAttempts CheckInAttempt[]

  @@unique([eventId, shortCode], map: "tickets_event_id_short_code_key")
  @@index([tokenHash, status, checkedInAt], map: "tickets_token_hash_status_checked_in_at_idx")
  @@index([eventId, status, type, issuedAt(sort: Desc)], map: "tickets_event_id_status_type_issued_at_idx")
  @@index([eventId, tableId, status], map: "tickets_event_id_table_id_status_idx")
  @@map("tickets")
}

model TicketGuest {
  ticketId  String   @map("ticket_id") @db.Uuid
  guestId   String   @map("guest_id") @db.Uuid
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@id([ticketId, guestId])
  @@unique([ticketId, position], map: "ticket_guests_ticket_id_position_key")
  @@index([guestId], map: "ticket_guests_guest_id_idx")
  @@map("ticket_guests")
}

model CheckInAttempt {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String        @map("event_id") @db.Uuid
  ticketId         String?       @map("ticket_id") @db.Uuid
  operatorUserId   String?       @map("operator_user_id") @db.Uuid
  result           CheckInResult
  isManual         Boolean       @default(false) @map("is_manual")
  manualReason     String?       @map("manual_reason") @db.VarChar(300)
  scannedAt        DateTime      @default(now()) @map("scanned_at") @db.Timestamptz(6)
  deviceLabel      String?       @map("device_label") @db.VarChar(120)
  unknownTokenHash String?       @map("unknown_token_hash") @db.Char(64)
  metadata         Json?         @db.JsonB

  event    Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticket   Ticket?    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  operator EventUser? @relation(fields: [operatorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, scannedAt(sort: Desc)], map: "check_in_attempts_event_id_scanned_at_idx")
  @@index([ticketId, scannedAt(sort: Desc)], map: "check_in_attempts_ticket_id_scanned_at_idx")
  @@index([operatorUserId, scannedAt(sort: Desc)], map: "check_in_attempts_operator_user_id_scanned_at_idx")
  @@index([eventId, result, scannedAt(sort: Desc)], map: "check_in_attempts_event_id_result_scanned_at_idx")
  @@map("check_in_attempts")
}

model AuditLog {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String      @map("event_id") @db.Uuid
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  action       AuditAction
  entityType   String      @map("entity_type") @db.VarChar(80)
  entityId     String?     @map("entity_id") @db.Uuid
  beforeData   Json?       @map("before_data") @db.JsonB
  afterData    Json?       @map("after_data") @db.JsonB
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actor EventUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt(sort: Desc)], map: "audit_logs_event_id_created_at_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_type_entity_id_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_logs_actor_user_id_created_at_idx")
  @@map("audit_logs")
}
