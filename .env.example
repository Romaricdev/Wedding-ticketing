# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL (Supabase)
# Runtime Prisma : pooler transaction mode (port 6543)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30&pool_timeout=30&connection_limit=5
# Migrations Prisma : connexion directe (port 5432)
# DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?connect_timeout=30
#
# Windows : supprimez toute variable utilisateur DATABASE_URL vers localhost si vous utilisez Supabase ici.
DATABASE_URL=
DIRECT_URL=

# QR — secret serveur pour HMAC des jetons (jamais exposé au client)
# QR_TOKEN_SECRET est recommandé (Phase 5). QR_TOKEN_PEPPER reste accepté en secours.
QR_TOKEN_SECRET=
QR_TOKEN_PEPPER=

# URL publique de l'application (optionnelle — le QR encode un jeton opaque, pas une URL)
# NEXT_PUBLIC_APP_URL=

# Seed de développement (npm run db:seed — jamais en production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CONTROLLER1_EMAIL=
SEED_CONTROLLER1_PASSWORD=
SEED_CONTROLLER2_EMAIL=
SEED_CONTROLLER2_PASSWORD=

# Tests E2E de rôle (optionnel — laisser vides ou supprimer ces lignes)
# Si une variable E2E_* est vide, SEED_* est utilisé automatiquement.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_CONTROLLER_EMAIL=
E2E_CONTROLLER_PASSWORD=
